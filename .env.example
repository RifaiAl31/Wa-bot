# Semua anggota boleh memakai perintah; kecuali /grup dan /grupaktif (khusus admin).
OPEN_ACCESS=true

# Nomor admin WhatsApp (hanya dipakai jika OPEN_ACCESS=false), format internasional tanpa + / spasi, dipisah koma
ADMIN_NUMBERS=6281234567890,6289876543210

# Server dashboard / API
PORT=3000
# Wajib diisi untuk mengunci panel management. Hash disimpan di database, bukan password.
ADMIN_PASSWORD=
# Set true hanya bila dashboard diakses lewat HTTPS/tunnel
COOKIE_SECURE=
WEB_SECRET_FILE=./data/web-secret
DEPLOY_BRANCH=main
DEPLOY_HEALTH_TIMEOUT_MS=120000
# Tunnel: kosongkan untuk quick tunnel, isi untuk named tunnel
TUNNEL_PORT=3000
TUNNEL_NAME=
TUNNEL_COMMAND=
# Ukuran maksimal upload dokumen MB
MAX_UPLOAD_MB=10
# Image quote creators (.iqc/.tqc)
IMAGE_TEMP_DIR=./data/tmp
IMAGE_MAX_MB=8
IMAGE_MAX_TEXT=500
IMAGE_MAX_SIDE=1600
IMAGE_TIMEOUT_MS=30000
IMAGE_TIMEOUT_MS=30000

# Path data (relatif terhadap root proyek)
DB_PATH=./data/bot.db
AUTH_DIR=./data/auth
QR_PATH=./data/qr.png
BACKUP_DIR=./data/backups

# Timezone penjadwalan (jangan diubah kecuali dipahami)
TZ=Asia/Jakarta

# === AI ASSISTANT ===
# Pilih salah satu penyedia. Isi salah satu API key di bawah ini.
# Jika keduanya diisi, OpenRouter dipakai kecuali AI_PROVIDER=gemini.
AI_PROVIDER=
# --- Opsi 1: OpenRouter (model gratis, divalidasi dari harga 0/0) ---
OPENROUTER_API_KEY=***
# Format: provider/model\:free. Kosongkan untuk memilih otomatis dari daftar gratis.
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# --- Opsi 2: Google Gemini (alternatif) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Daftar model free-tier yang diizinkan, pisah koma. Bisa ditambah manual.
GEMINI_FREE_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-flash-latest,gemini-2.5-flash
GEMINI_VISION_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
GEMINI_VISION_MODEL=
AI_COOLDOWN_SECONDS=20
# Jangan kirim notifikasi cooldown berulang dalam jendela ini (detik)
AI_COOLDOWN_NOTICE_SECONDS=20
# Dedup pesan Baileys berdasarkan message ID (milidetik)
MESSAGE_DEDUPE_TTL_MS=300000
# Command '.' yang diizinkan di chat pribadi, pisah koma. Kosong = tidak ada
PRIVATE_DOT_COMMANDS=
# Set 1 hanya untuk menjalankan dua proses dengan database berbeda (mis. verifikasi)
ALLOW_MULTI_INSTANCE=
AI_WINDOW_MINUTES=60
AI_MAX_PER_USER=20
# Sandi aktivasi VIP (dimasukkan hanya di private chat / web)
VIP_PASSWORD=
VIP_SESSION_TTL_MS=120000
VIP_MAX_ATTEMPTS=3
VIP_LOCK_MS=300000
AI_GLOBAL_MAX=60
AI_MAX_QUESTION_CHARS=1200
AI_TIMEOUT_MS=20000
AI_MAX_ANSWER_TOKENS=4000
AI_MAX_ANSWER_CHARS=3000
AI_PDF_MAX_PAGES=50
AI_PDF_MAX_CHARS=12000
AI_MODELS_CACHE_MINUTES=30
AI_CONTEXT_MESSAGES=0

LOG_LEVEL=info
RETRY_LIMIT=2
RETRY_DELAY_MS=1500
